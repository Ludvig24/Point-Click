<Window x:Class="Point_Click.Room2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Point_Click"
        mc:Ignorable="d"
        Title="Room2Window" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.494,0.442">
        <Button x:Name="GoToRoom1" Content="" HorizontalAlignment="Left" Height="138" Margin="10,113,0,0" VerticalAlignment="Top" Width="75" Click="GoToRoom1_Click" ToolTip="Dette er en dør til det lokale du kom fra"/>
        <Button x:Name="Ladder" Content="Ladder" HorizontalAlignment="Center" Margin="0,227,0,0" VerticalAlignment="Top" Height="39" Width="394" Click="Ladder_Click" ToolTip="Dette er en stige, den kan bruges til at nå høje ting"/>
        <Button x:Name="Kage" Content="Kage" HorizontalAlignment="Left" Margin="429,74,0,0" VerticalAlignment="Top" Height="34" Width="52" Click="Kage_Click" ToolTip="Denne kage er godt nok højt oppe, men gad vide om der er noget inde i den"/>
        <Button x:Name="Shelf" Content="(Hylde)" HorizontalAlignment="Left" Margin="356,108,0,0" VerticalAlignment="Top" Click="Shelf_Click" Width="198" Height="19" ToolTip="Du kan sku ikke nå uden hjælp"/>

        <ListBox Height="79" HorizontalAlignment="Left" Margin="226,283,0,0" x:Name="InvListBox" VerticalAlignment="Top" Width="350" >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5 0 10 0" />
                </Style>
            </ListBox.ItemContainerStyle>


        </ListBox>
        <Button x:Name="Ladder2" Content="Ladder" HorizontalAlignment="Left" Margin="382,188,0,0" VerticalAlignment="Top" Width="148" Height="22" RenderTransformOrigin="0.5,0.5" Visibility="Hidden" ToolTip="Den stige har du placeret stabilt og godt">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="ExitDoor" Content="" HorizontalAlignment="Left" Margin="689,98,0,0" VerticalAlignment="Top" Height="168" Width="80" Click="ExitDoor_Click" ToolTip="Døren er låst, du skal bruge et Keycard"/>
        <TextBlock HorizontalAlignment="Left" Margin="720,79,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Exit"/><LineBreak/><Run/></TextBlock>
        <Rectangle HorizontalAlignment="Left" Height="14" Margin="689,175,0,0" Stroke="Black" VerticalAlignment="Top" Width="13"/>
        <Rectangle HorizontalAlignment="Left" Height="14" Margin="689,175,0,0" Stroke="Black" VerticalAlignment="Top" Width="7"/>
        <TextBlock HorizontalAlignment="Left" Margin="229,267,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Inventory"/><LineBreak/><Run/></TextBlock>
    </Grid>
</Window>
